# Use a different port if 5000 is already in use (must match VITE_API_URL in frontend .env)
PORT=5001
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
NODE_ENV=development

# Firebase Realtime Database
# FIREBASE_DB_KEY must be a Base64-encoded Firebase service account JSON key.
# The backend decodes it at runtime and uses Firebase Admin SDK credentials.
# FIREBASE_DB_URL is optional; if omitted, the default instance URL is derived from the service account project id.
# FIREBASE_DB_KEY=
# FIREBASE_DB_URL=

# Vertex AI (uses GOOGLE_CLOUD_ADC_KEY when non-empty; avoids bogus GEMINI_* placeholders)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: base64-encoded Google credential JSON (entire key file, no extra wrapping).
# Decoded JSON is passed as GoogleGenAI googleAuthOptions.credentials (Vertex).
# Typical: service account key JSON from IAM.
# Encode (single line), e.g. GNU: base64 -w0 service-account.json
#   macOS: base64 service-account.json | tr -d '\n'
# Do not commit real values; use secrets in production.
# GOOGLE_CLOUD_ADC_KEY=

# Gemini Developer API (AI Studio). Ignored if placeholders like your_*.
# If GOOGLE_CLOUD_ADC_KEY is non-empty, Vertex with that credential wins over this.
# GEMINI_API_KEY=

